# BigModel 站点基础URL（默认）
BIGMODEL_BASE_URL="https://bigmodel.cn"

# 聊天API端点（根据实际请求填写，默认值）
BIGMODEL_CHAT_ENDPOINT="/api/chat/completions"

# 模型列表API端点（根据实际请求填写，默认值）
BIGMODEL_MODELS_ENDPOINT="/api/models"
