# Qwen FastAPI 逆向代理配置示例
# 复制此文件为 .env 并填入真实配置

# ==================== 必需配置 ====================

# --- 千问 (Qwen) 配置 ---
# 方式一：只设置 QWEN_COOKIES（推荐）
# Cookie信息会自动提取token，简化配置
QWEN_COOKIES="your_complete_cookies_here"

# 方式二：分别设置（可选）
# 如果COOKIES中已包含token，则无需单独设置QWEN_AUTH_TOKEN
# QWEN_AUTH_TOKEN="your_auth_token_here"

# --- 智谱AI (BigModel) 配置 ---
# 必填：智谱AI API Key (从 https://open.bigmodel.cn/usercenter/apikeys 获取)
ZHIPU_API_KEY="your_zhipu_api_key_here"
# 可选：智谱AI API 基地址
ZHIPU_BASE_URL="https://open.bigmodel.cn/api/paas/v4"

# ==================== API鉴权配置 ====================

# 有效的API访问Token列表（JSON数组格式或逗号分隔）
# 如果不配置此项，API将不进行鉴权验证（开发模式）
#
# JSON数组格式（推荐）：
VALID_TOKENS=["sk-zhouhui1122444", "sk-zhouhui11224555", "sk-your-custom-token"]
#
# 或逗号分隔格式：
# VALID_TOKENS=sk-zhouhui1122444,sk-zhouhui11224555,sk-your-custom-token
#
# 使用方式：
#   客户端请求时需要在Authorization头中携带：Bearer <your_token>
#   例如：Authorization: Bearer sk-zhouhui1122444
#
# 注意事项：
#   - Token可以自定义，建议使用"sk-"前缀以兼容OpenAI格式
#   - 可以为不同用户/应用分配不同的Token
#   - 定期更换Token以提高安全性
#   - 不配置VALID_TOKENS时，所有请求无需鉴权（仅开发环境使用）

# ==================== 可选配置 ====================

# 服务端口（默认8000）
# PORT=8000

# 是否开启调试模式（默认false）
# DEBUG_STATUS=false

# 是否自动删除临时对话（默认0不删除）
# IS_DELETE=0

# ==================== 获取配置说明 ====================

# 获取 QWEN_COOKIES：
# 1. 访问 https://chat.qwen.ai 并登录
# 2. 打开浏览器开发者工具（F12）
# 3. 切换到 Network/网络 标签页
# 4. 在网站上发送一条消息
# 5. 找到 chat/completions 请求
# 6. 查看 Request Headers，复制完整的 Cookie 值
# 7. Cookie示例格式：
#    _gcl_au=1.1.xxx; cna=xxx; token=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 单独获取 QWEN_AUTH_TOKEN（可选）：
# 1. F12 开发者工具 -> Applications/应用
# 2. 左侧 Local Storage -> chat.qwen.ai
# 3. 右侧找到 "token" 的值并复制

# ==================== 智谱AI (BigModel) 浏览器Cookies配置 ====================
# 注意：此配置用于基于浏览器Cookies的反向代理（而非官方API）

# BigModel 浏览器Cookies（必填）
# 从浏览器Network标签页获取，方法如下：
# 1. 访问 https://bigmodel.cn/trialcenter/modeltrial/text 并登录
# 2. 打开 F12 -> Network 标签页
# 3. 发送一条消息
# 4. 找到 chat/completions 请求
# 5. 复制 Request Headers 中的完整 Cookie 值
